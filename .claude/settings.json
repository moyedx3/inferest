{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(cat *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(bat *.env)",
      "Bash(open *.env)",
      "Bash(grep * .env)",
      "Bash(printenv *KEY*)"
    ]
  }
}
