# copy to .env.monad at the repository root for the Monad fork demo instance; see deploy/README.md.
# the fork's admin RPC from the Tenderly dashboard: a credential, it accepts the cheat methods the faucet and the clock use.
RPC_URL=
# the keeper signer must match initialRoles.keeper in contracts/deployments/monad-fork.json, or redeploy and replace the record.
KEEPER_PRIVATE_KEY=
KEEPER_AUTOMATIC_TRANSACTIONS=true
# leave both empty on the fork.
KEEPER_MIN_BALANCE_ETH=
KEEPER_MAX_TX_COST_ETH=
PILOT_CUSTOMER_ADDRESS=
OPENROUTER_MANAGEMENT_KEY=
# lifetime USD allowance across this instance's model keys; the fork carries test money, the provider does not.
OPENROUTER_TOTAL_LIMIT_USD=0.9
# fresh values for this instance, never another instance's: openssl rand -hex 32
ADMIN_TOKEN=
KEY_ENCRYPTION_KEY=
# optional paid tools; they pay real USDC on Base whatever chain the vaults are on.
ORTHOGONAL_API_KEY=
TOOL_WALLET_PRIVATE_KEY=
# this instance's own origin behind the reverse proxy; also one of the Dynamic environment's allowed origins.
PUBLIC_URL=https://monad.example.com
# the same list on every instance turns the network chip into a chain picker; name|url pairs, this instance included.
CHAIN_SITES=Arbitrum One|https://inferest.example.com,Monad|https://monad.example.com
# the fork's public RPC: browser-visible, refuses the cheat methods. This is the fork recorded in contracts/deployments/monad-fork.json.
PUBLIC_RPC_URL=https://virtual.monad.eu.rpc.tenderly.co/ae159768-40d0-4b2e-903d-0d057c3f7bdb
DYNAMIC_ENVIRONMENT_ID=
# 1: demo funds and the clock come from the fork's cheat methods over RPC_URL.
DEMO_FAUCET=1
RAIL_FEE=0
