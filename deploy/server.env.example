# copy to .env.server at the repository root and fill in the empty values.
# the keeper signer must match KEEPER from the contract deployment.
RPC_URL=http://host.docker.internal:8545
KEEPER_PRIVATE_KEY=
# false disables automatic reports and settlements; receipt/model reconciliation and limit sync continue
KEEPER_AUTOMATIC_TRANSACTIONS=true
# optional ETH reserve after each keeper transaction and maximum gas * fee ceiling per transaction
KEEPER_MIN_BALANCE_ETH=
KEEPER_MAX_TX_COST_ETH=
# optional single factory customer admitted by registration, including operator requests; does not restrict the factory
PILOT_CUSTOMER_ADDRESS=
OPENROUTER_MANAGEMENT_KEY=
# optional lifetime USD allowance across registered model keys; one keeper process, retain its database
OPENROUTER_TOTAL_LIMIT_USD=
ADMIN_TOKEN=
# generate 32 random bytes as hex: openssl rand -hex 32
KEY_ENCRYPTION_KEY=
# optional paid tools; a funded Base USDC wallet is needed for x402 calls.
ORTHOGONAL_API_KEY=
TOOL_WALLET_PRIVATE_KEY=
PUBLIC_URL=http://localhost:8787
# browser-visible RPC, never a credential-bearing keeper/admin endpoint.
PUBLIC_RPC_URL=http://localhost:8545
# optional Dynamic login; empty leaves operator-token access available.
DYNAMIC_ENVIRONMENT_ID=
# enable only on an explicitly verified disposable fork or virtual testnet.
DEMO_FAUCET=0
RAIL_FEE=0
