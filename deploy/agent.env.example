# copy to .env.agent at the repository root only when using the agent profile.
RPC_URL=http://host.docker.internal:8545
# must match the server's ADMIN_TOKEN; a vault-scoped credential is not built yet.
ADMIN_TOKEN=
AGENT_PRIVATE_KEY=
AGENT_BOOK_USDC=1000
AGENT_FLOOR_USDC=200
AGENT_INTERVAL_MS=600000
# keep 0 unless this endpoint is explicitly verified as a disposable fork.
AGENT_DEMO_DAYS=0
AGENT_MODEL=moonshotai/kimi-k2.6
AGENT_MAX_TURNS=10
AGENT_MAX_TOOL_CALLS=4
AGENT_TRADE_CAP_BPS=2000
